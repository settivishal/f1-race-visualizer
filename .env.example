# Neon connection string (pooled). Never commit the real one.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Seeded admin account. No defaults exist in source — a missing value must fail, not fall back.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Targeting the dev database. Production values live in .env; the Neon dev branch
# lives in .env.dev, under the same DATABASE_URL key — the filename is the selector.
# Nothing auto-loads it: dotenv reads .env only, and it does not override a variable
# that is already set, so exporting the dev value first wins.
#
#   env $(grep -v '^#' .env.dev | xargs) pnpm tsx scripts/backfill.ts 2025
#
# CI does the same thing with different names: GitHub secrets share one namespace,
# so the dev URL is stored as DATABASE_URL_DEV and bound to DATABASE_URL by
# .github/workflows/migrate.yml. Code reads DATABASE_URL everywhere.
