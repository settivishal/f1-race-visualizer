# Neon connection string (pooled). Never commit the real one.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Seeded admin account. No defaults exist in source — a missing value must fail, not fall back.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Which database: .env holds the Neon DEV branch, so every local command
# (next dev, drizzle-kit, scripts/*) hits dev by default. Production lives in
# .env.prod, same keys, and nothing auto-loads it. Opt in per command; Node sets
# the variables first and dotenv never overrides one that is already set:
#
#   pnpm tsx --env-file=.env.prod scripts/backfill.ts 2025
#
# Don't name it .env.production: `next build` loads that automatically.
#
# CI does the same thing with different names: GitHub secrets share one namespace,
# so the dev URL is stored as DATABASE_URL_DEV and bound to DATABASE_URL by
# .github/workflows/migrate.yml. Code reads DATABASE_URL everywhere.
AUTH_SECRET=
CRON_SECRET=
