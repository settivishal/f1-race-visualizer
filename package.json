{
  "name": "f1-race-visualizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint && eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "lint:fix": "oxlint --fix && eslint --fix",
    "gql:schema": "tsx scripts/print-schema.ts",
    "gql:generate": "pnpm gql:schema && graphql-codegen --config codegen.ts",
    "gql:check": "pnpm gql:schema && git diff --exit-code schema.graphql && graphql-codegen --config codegen.ts --check"
  },
  "dependencies": {
    "@escape.tech/graphql-armor-cost-limit": "^2.4.3",
    "@escape.tech/graphql-armor-max-depth": "^2.4.2",
    "@graphql-yoga/plugin-disable-introspection": "^2.23.0",
    "@neondatabase/serverless": "^1.1.0",
    "@pothos/core": "^4.13.1",
    "@pothos/plugin-relay": "^4.7.1",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.22.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-oxlint": "^1.81.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  }
}
